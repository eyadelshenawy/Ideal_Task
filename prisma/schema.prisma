generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Pooled (PgBouncer) — used for normal app queries, handles many
  // concurrent connections without exhausting Postgres's own connection limit.
  url       = env("DATABASE_URL")
  // Direct (non-pooled) — migrations need this; PgBouncer's transaction
  // pooling mode doesn't support the session-level features migrations use.
  directUrl = env("DIRECT_DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  MEMBER
}

enum Priority {
  HIGH
  MEDIUM
  LOW
}

enum Status {
  TODO
  READY
  INPROGRESS
  INTERNAL_TEST
  CUSTOMER_TEST
  DONE
}

enum TaskEventType {
  COMMENT
  ACTIVITY
}

enum RecurrenceFreq {
  DAILY
  WEEKLY
  MONTHLY
}

model User {
  id                 String   @id @default(cuid())
  name               String
  email              String   @unique
  passwordHash       String
  role               Role     @default(MEMBER)
  active             Boolean  @default(true)
  // Forces a redirect to /change-password on next login. Set true whenever an
  // admin creates an account or resets a password (see build brief section 4).
  mustChangePassword Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  // Brute-force protection: incremented on each wrong password, reset on
  // success; lockedUntil is set once the threshold is hit (see auth.ts).
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?

  // Self-service "forgot password" — resetTokenHash stores a sha256 of the
  // token actually emailed to the user, never the raw token itself.
  resetTokenHash    String?   @unique
  resetTokenExpires DateTime?

  tasksAssigned Task[] @relation("TaskAssignees")
  tasksCreated  Task[] @relation("CreatedTasks")
  taskEvents    TaskEvent[]
  notifications Notification[]
  auditLogs     AuditLog[]
  attachmentsUploaded Attachment[]
  timeEntries         TimeEntry[]

  // Per-project admin grants — presence of a row means this user can create/
  // edit/delete tasks in that project, independent of their global Role.
  projectAdminOf ProjectAdmin[]

  pushSubscriptions PushSubscription[]
}

// One row per browser/device a user has opted into Web Push on. A user can
// have several (phone, laptop, ...); each gets its own delivery attempt.
model PushSubscription {
  id       String @id @default(cuid())
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint String @unique
  p256dh   String
  auth     String

  createdAt DateTime @default(now())

  @@index([userId])
}

// Global SLA targets, editable by a Super Admin instead of hardcoded — see
// src/lib/sla.ts. A singleton row (id is always "default"); reading falls
// back to sensible defaults if the row doesn't exist yet.
// One row per project that has its own SLA targets, plus exactly one row
// with projectId "__default__" — the system-wide fallback used by any
// project without its own override. Kept as a plain string id rather than a
// Project relation so the sentinel default row doesn't need a real project
// to point at; per-project rows are looked up by that same string.
model SlaConfig {
  id        String @id @default(cuid())
  projectId String @unique

  highResponseHours    Int @default(4)
  highResolutionDays   Int @default(2)
  mediumResponseHours  Int @default(24)
  mediumResolutionDays Int @default(5)
  lowResponseHours     Int @default(48)
  lowResolutionDays    Int @default(10)

  // Tasks created before this date are excluded from SLA calculations
  // entirely — without this, importing/pre-existing backlog tasks that
  // predate the feature would permanently read as "breached."
  cutoffDate DateTime?

  updatedAt DateTime @updatedAt
}

model Project {
  id        String    @id @default(cuid())
  name      String
  // Short prefix used to auto-generate task codes for this project, e.g.
  // "APEX" -> "APEX-0001", "APEX-0002". taskCodeSeq is the running counter;
  // it advances on every task created for this project (import included),
  // but the resulting code is just a suggestion the task form pre-fills —
  // users can still edit it per task (e.g. "APEX-FI-0001" for a department).
  code        String @unique
  taskCodeSeq Int    @default(0)
  createdAt DateTime  @default(now())
  // Soft-delete: set when moved to Trash. Tasks referencing this project are
  // left untouched while it sits in Trash — only permanently unassigned (via
  // Task.projectId's onDelete: SetNull) if the project is purged for good.
  deletedAt DateTime?

  // A long random token that, if set, makes /share/[shareToken] a public,
  // read-only status page for this project — no login required. Null means
  // sharing is off. Regenerating (or clearing) it invalidates any existing
  // link immediately, since the old token no longer matches anything.
  shareToken String? @unique

  // A long random token that, if set, makes /intake/[intakeToken] a public,
  // unauthenticated form — anyone with the link can submit a new ticket,
  // which lands as a Task in this project. Separate from shareToken so the
  // two links can be handed out and revoked independently.
  intakeToken String? @unique

  // Off by default — SLA (response/resolution time targets) only makes sense
  // for support/ticket-style work measured from creation; an implementation
  // project's tasks are scheduled with their own Start/Due dates instead, so
  // dragging them into SLA percentages would be misleading. Turn this on
  // per-project for the ones that are actually support contracts.
  slaTrackingEnabled Boolean @default(false)

  tasks        Task[]
  admins       ProjectAdmin[]
  customFields CustomField[]
}

enum CustomFieldType {
  TEXT
  NUMBER
  SELECT
}

// A field a Super Admin has defined for a specific project (e.g. a SAP
// project wanting a "Transaction Code" field) — scoped to that project only,
// shown on every task within it.
model CustomField {
  id        String          @id @default(cuid())
  projectId String
  project   Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name      String
  type      CustomFieldType
  // Only meaningful when type is SELECT — the list of choices.
  options   String[]
  order     Int             @default(0)
  createdAt DateTime        @default(now())

  values TaskCustomFieldValue[]

  @@index([projectId])
}

// One task's value for one of its project's custom fields. Stored as text
// regardless of field type — NUMBER/SELECT values are just parsed/validated
// on the way in and out.
model TaskCustomFieldValue {
  id      String      @id @default(cuid())
  taskId  String
  task    Task        @relation(fields: [taskId], references: [id], onDelete: Cascade)
  fieldId String
  field   CustomField @relation(fields: [fieldId], references: [id], onDelete: Cascade)
  value   String

  @@unique([taskId, fieldId])
  @@index([taskId])
}

model ProjectAdmin {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, projectId])
}

// A free-form label a task can carry, independent of status/priority
// (e.g. "client-facing", "on legal hold"). Created on demand by name.
model Tag {
  id    String @id @default(cuid())
  name  String @unique
  tasks Task[] @relation("TaskTags")
}

// A task assignee who isn't a system user — a client contact or other
// external person. Just a display name, no login/credentials.
model Contact {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())

  tasksAssigned Task[] @relation("TaskContactAssignees")
}

model Task {
  id          String  @id @default(cuid())
  code        String? @unique
  title       String
  description String?

  // A private personal task: visible only to createdById, never through any
  // shared view/report/export/reminder — not even to a Super Admin. Always
  // projectId: null. See src/lib/taskVisibility.ts for the enforcement.
  isPrivate Boolean @default(false)
  // Free-text software/work module this task belongs to (e.g. "Billing",
  // "Auth"). Not required — purely informational, filled in when relevant.
  module      String?

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  // A task can have any number of assignees, mixing real team members and
  // external Contacts.
  assignees        User[]    @relation("TaskAssignees")
  contactAssignees Contact[] @relation("TaskContactAssignees")
  tags             Tag[]     @relation("TaskTags")

  priority Priority @default(MEDIUM)
  status   Status   @default(TODO)

  startDate DateTime?
  dueDate   DateTime?
  progress  Int       @default(0)

  // When this task actually finished — auto-set to today whenever status
  // moves to DONE (and cleared if reopened), but editable by hand so a user
  // can log a different actual completion date.
  completedAt DateTime?

  // Set once the "due tomorrow" reminder email has been sent for the current
  // dueDate. Cleared whenever dueDate changes so a future move back to
  // "tomorrow" re-triggers the reminder. Overdue reminders have no such gate —
  // they resend daily for as long as the task stays overdue.
  dueSoonNotifiedAt DateTime?

  // One-time gates for the proactive SLA-risk warning (sent once a task's
  // response or resolution deadline is close but not yet breached, for
  // tasks in an SLA-tracked project). Never cleared automatically — unlike
  // dueSoonNotifiedAt, response/resolution deadlines are pinned to the
  // immutable createdAt, so there's no equivalent "date changed" reset case.
  responseRiskNotifiedAt   DateTime?
  resolutionRiskNotifiedAt DateTime?

  // Recurrence: when set, completing this task auto-creates the next
  // occurrence (same project/assignees/priority), due one interval later.
  // Null recurrenceFreq means "not a recurring task".
  recurrenceFreq     RecurrenceFreq?
  recurrenceEndDate  DateTime?

  isMilestone Boolean @default(false)

  // Set only for tasks created through the public ticket-intake form — lets
  // the submitter check status later at /track/[trackingToken] without an
  // account. A dedicated random token (not the task's own id), matching the
  // shareToken/intakeToken convention elsewhere: never reuse a database id
  // as a public-facing credential.
  trackingToken String? @unique

  // Predecessor tasks that must be Done before this one is unblocked.
  dependsOn Task[] @relation("TaskDependencies")
  blocks    Task[] @relation("TaskDependencies")

  // Parent/child task hierarchy (e.g. ABC-0001 -> ABC-0001-01). A child must
  // live in the same project as its parent — enforced in the API layer, not
  // here. childCodeSeq is this task's own running counter for ITS children's
  // codes, mirroring Project.taskCodeSeq one level down.
  parentId     String?
  parent       Task?   @relation("TaskHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children     Task[]  @relation("TaskHierarchy")
  childCodeSeq Int     @default(0)

  // Nullable so a Super Admin can permanently delete a user's account even
  // after they've created tasks — the task survives, it just loses creator
  // attribution (not surfaced in the UI anyway).
  createdById String?
  createdBy   User?   @relation("CreatedTasks", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  // Soft-delete: set when moved to Trash instead of being deleted outright.
  deletedAt DateTime?

  events TaskEvent[]
  checklistItems ChecklistItem[]
  attachments Attachment[]
  timeEntries TimeEntry[]
  customFieldValues TaskCustomFieldValue[]

  @@index([projectId])
  @@index([status])
  @@index([deletedAt])
  @@index([parentId])
}

// System-wide audit trail — logins, team/project management, permission
// grants. Separate from TaskEvent, which is per-task activity only. Useful
// once there's more than one admin and you need to know who did what,
// anywhere in the system.
model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  actor     User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  message   String
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// In-app notification bell — created when someone is assigned a task or
// a task they're on gets a new comment. Separate from the email
// notifications in src/lib/notifications.ts.
model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  message   String
  taskId    String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
}

// A checklist line within a task — a lightweight step, not a full Task (no
// status/assignee/dates of its own).
model ChecklistItem {
  id        String   @id @default(cuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  text      String
  done      Boolean  @default(false)
  order     Int      @default(0)
  createdAt DateTime @default(now())

  @@index([taskId])
}

// A named, reusable set of checklist steps (e.g. "SAP PO ticket diagnosis")
// a Super Admin defines once and anyone can apply to any task's own
// checklist — not tied to a project, since the same recurring steps often
// apply across support projects.
model ChecklistTemplate {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())

  items ChecklistTemplateItem[]
}

model ChecklistTemplateItem {
  id         String            @id @default(cuid())
  templateId String
  template   ChecklistTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  text       String
  order      Int               @default(0)

  @@index([templateId])
}

// A manually-logged block of time someone spent on a task — no timer, just
// "I spent N hours on this, on this date." Multiple people can log time on
// the same task; the task's total is the sum of all entries.
model TimeEntry {
  id     String @id @default(cuid())
  taskId String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  // Nullable so deleting a user doesn't delete their logged hours.
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  hours Float
  date  DateTime
  note  String?

  createdAt DateTime @default(now())

  @@index([taskId])
}

// A file uploaded to a task, stored in Cloudflare R2 (S3-compatible). `fileKey`
// is the R2 object key; the file itself never touches the database.
model Attachment {
  id       String @id @default(cuid())
  taskId   String
  task     Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  fileName String
  fileKey  String
  fileSize Int
  mimeType String

  // Nullable so deleting a user doesn't delete their uploaded files.
  uploadedById String?
  uploadedBy   User?   @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([taskId])
}

// A single chronological entry on a task — either a user-written comment or
// a system-generated activity line (status/assignee/project/date changes).
model TaskEvent {
  id     String        @id @default(cuid())
  taskId String
  task   Task          @relation(fields: [taskId], references: [id], onDelete: Cascade)
  type   TaskEventType
  // Comment text (verbatim) or a human-readable activity description.
  message String

  // Nullable so deleting a user doesn't delete their comment/activity history.
  authorId String?
  author   User?   @relation(fields: [authorId], references: [id], onDelete: SetNull)

  createdAt DateTime  @default(now())
  // Set when a comment (never an activity line) is edited after posting.
  editedAt  DateTime?

  @@index([taskId])
}
