generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MEMBER
}

enum Priority {
  HIGH
  MEDIUM
  LOW
}

enum Status {
  TODO
  INPROGRESS
  REVIEW
  DONE
}

model User {
  id                 String   @id @default(cuid())
  name               String
  email              String   @unique
  passwordHash       String
  role               Role     @default(MEMBER)
  active             Boolean  @default(true)
  // Forces a redirect to /change-password on next login. Set true whenever an
  // admin creates an account or resets a password (see build brief section 4).
  mustChangePassword Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  tasksAssigned Task[] @relation("AssignedTasks")
  tasksCreated  Task[] @relation("CreatedTasks")
}

model Project {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())

  tasks Task[]
}

model Task {
  id          String    @id @default(cuid())
  code        String?
  title       String
  description String?

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  assigneeId String?
  assignee   User?   @relation("AssignedTasks", fields: [assigneeId], references: [id], onDelete: SetNull)

  priority Priority @default(MEDIUM)
  status   Status   @default(TODO)

  startDate DateTime?
  dueDate   DateTime?
  progress  Int       @default(0)

  isMilestone Boolean @default(false)

  // Predecessor tasks that must be Done before this one is unblocked.
  dependsOn Task[] @relation("TaskDependencies")
  blocks    Task[] @relation("TaskDependencies")

  createdById String
  createdBy   User   @relation("CreatedTasks", fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
  @@index([assigneeId])
  @@index([status])
}
