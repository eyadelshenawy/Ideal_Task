generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  MEMBER
}

enum Priority {
  HIGH
  MEDIUM
  LOW
}

enum Status {
  TODO
  INPROGRESS
  REVIEW
  DONE
}

model User {
  id                 String   @id @default(cuid())
  name               String
  email              String   @unique
  passwordHash       String
  role               Role     @default(MEMBER)
  active             Boolean  @default(true)
  // Forces a redirect to /change-password on next login. Set true whenever an
  // admin creates an account or resets a password (see build brief section 4).
  mustChangePassword Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  tasksAssigned Task[] @relation("TaskAssignees")
  tasksCreated  Task[] @relation("CreatedTasks")

  // Per-project admin grants — presence of a row means this user can create/
  // edit/delete tasks in that project, independent of their global Role.
  projectAdminOf ProjectAdmin[]
}

model Project {
  id        String    @id @default(cuid())
  name      String
  createdAt DateTime  @default(now())
  // Soft-delete: set when moved to Trash. Tasks referencing this project are
  // left untouched while it sits in Trash — only permanently unassigned (via
  // Task.projectId's onDelete: SetNull) if the project is purged for good.
  deletedAt DateTime?

  tasks  Task[]
  admins ProjectAdmin[]
}

model ProjectAdmin {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, projectId])
}

// A task assignee who isn't a system user — a client contact or other
// external person. Just a display name, no login/credentials.
model Contact {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())

  tasksAssigned Task[] @relation("TaskContactAssignees")
}

model Task {
  id          String  @id @default(cuid())
  code        String?
  title       String
  description String?

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  // A task can have any number of assignees, mixing real team members and
  // external Contacts.
  assignees        User[]    @relation("TaskAssignees")
  contactAssignees Contact[] @relation("TaskContactAssignees")

  priority Priority @default(MEDIUM)
  status   Status   @default(TODO)

  startDate DateTime?
  dueDate   DateTime?
  progress  Int       @default(0)

  isMilestone Boolean @default(false)

  // Predecessor tasks that must be Done before this one is unblocked.
  dependsOn Task[] @relation("TaskDependencies")
  blocks    Task[] @relation("TaskDependencies")

  // Nullable so a Super Admin can permanently delete a user's account even
  // after they've created tasks — the task survives, it just loses creator
  // attribution (not surfaced in the UI anyway).
  createdById String?
  createdBy   User?   @relation("CreatedTasks", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  // Soft-delete: set when moved to Trash instead of being deleted outright.
  deletedAt DateTime?

  @@index([projectId])
  @@index([status])
  @@index([deletedAt])
}
