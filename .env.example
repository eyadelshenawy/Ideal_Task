# Postgres connection string. On Render, use the "External Database URL" (for
# local dev against a Render DB) or the internal one (once deployed on Render).
DATABASE_URL="postgresql://user:password@host:5432/dbname?schema=public"

# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-random-32-byte-secret"

# Base URL of the app. http://localhost:3000 for local dev.
NEXTAUTH_URL="http://localhost:3000"

# Resend API key (resend.com/api-keys) - used to send task notification emails.
RESEND_API_KEY="re_xxxxxxxx"

# "From" address for outgoing emails. Domain must be verified in Resend.
EMAIL_FROM="IDEAL Tasks <admin@ideal-dt.com>"

# Shared secret the daily notifications cron job sends as "Authorization: Bearer <secret>".
# Generate with: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
CRON_SECRET="replace-with-a-random-secret"
